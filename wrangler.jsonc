{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "folio-admin",
  "main": "./admin/worker.mjs",
  "compatibility_date": "2026-03-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./admin/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "742801",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
